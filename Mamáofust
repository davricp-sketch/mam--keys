local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local WORKER_URL = "https://patient-cake-b6ee.davricp.workers.dev/"
local KEY_FILE = "DVDR_SavedKey.txt"

local httpRequest = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request

local function GetHWID()
    if type(gethwid) == "function" then
        local ok, value = pcall(gethwid)
        if ok and value and tostring(value) ~= "" then return tostring(value) end
    end
    return "UNKNOWN_HWID"
end

local function LoadSavedKeyLocally()
    if readfile and isfile then
        local ok, exists = pcall(function() return isfile(KEY_FILE) end)
        if ok and exists then
            local success, content = pcall(function() return readfile(KEY_FILE) end)
            if success and content then return content:gsub("%s+", "") end
        end
    end
    return ""
end

local function SaveKeyLocally(key)
    if writefile then pcall(function() writefile(KEY_FILE, key) end) end
end

local function VerifyKeyInCloud(keyCode)
    local currentHWID = GetHWID()
    local payload = HttpService:JSONEncode({
        key = keyCode,
        hwid = currentHWID
    })

    if httpRequest then
        local ok, res = pcall(function()
            return httpRequest({
                Url = WORKER_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
        end)
        if ok and type(res) == "table" and res.Body then
            local decodeOk, parsed = pcall(function()
                return HttpService:JSONDecode(res.Body)
            end)
            if decodeOk and parsed then
                return parsed.success, parsed.message
            end
        end
    end
    return false, "❌ Error de conexión con el Worker o exploit no compatible."
end


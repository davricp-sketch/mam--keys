            local ok, res = pcall(function()
                return httpRequest({ Url = githubScriptUrl, Method = "GET" })
            end)
            if ok and type(res) == "table" and res.Body and res.Body ~= "" then
                scriptContent = res.Body
                fetchSuccess = true
            end
        end

        if not fetchSuccess then
            local ok, res = pcall(function()
                return game:HttpGet(githubScriptUrl)
            end)
            if ok and res and res ~= "" then
                scriptContent = res
                fetchSuccess = true
            end
        end

        if fetchSuccess and scriptContent ~= "" then
            print("🟢 [DEBUG] ¡Script de GitHub descargado con éxito! Longitud:", #scriptContent)
            local runOk, err = pcall(function()
                loadstring(scriptContent)()
            end)
            if runOk then
                print("🟢 [DEBUG] ¡Hub ejecutado perfectamente!")
            else
                warn("❌ [ERROR] Falló el loadstring del script: " .. tostring(err))
            end
        else
            warn("❌ [ERROR] No se pudo descargar nada desde GitHub.")
        end

    else
        StatusMsg.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusMsg.Text = message
    end
end)
